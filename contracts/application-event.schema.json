{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "ApplicationEvent",
  "required": [
    "id",
    "application_id",
    "job_id",
    "event_type",
    "recorded_at",
    "actor",
    "source",
    "outcome_status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "application_id": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "resume_variant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "event_type": {
      "type": "string",
      "enum": [
        "saved",
        "drafted",
        "approved",
        "submitted",
        "recruiter_screen",
        "interview",
        "rejected",
        "offer",
        "withdrawn",
        "note"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "occurred_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "enum": [
        "user",
        "system",
        "import"
      ]
    },
    "source": {
      "type": "string"
    },
    "outcome_status": {
      "type": "string",
      "enum": [
        "observed",
        "self-reported",
        "unknown"
      ]
    },
    "experiment_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_token_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": "string"
    }
  }
}
