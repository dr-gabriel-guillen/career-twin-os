{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "ProfileClaim",
  "required": [
    "id",
    "subject_id",
    "claim_type",
    "claim_text",
    "status",
    "evidence_ids",
    "visibility",
    "updated_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "skill",
        "role",
        "employment",
        "education",
        "credential",
        "project",
        "achievement",
        "other"
      ]
    },
    "claim_text": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "supported",
        "self-reported",
        "contradicted",
        "unverified"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shareable",
        "public-approved"
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
