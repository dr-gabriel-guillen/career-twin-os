{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careertwin.local/lane-c/transition-scenario-outputs.v0.1.schema.json",
  "title": "TransitionScenarioOutputs",
  "description": "Shape of TransitionScenario.outputs as produced by lane C. The frozen contract leaves `outputs` as a free object; this schema documents what consumers can rely on. Superset of lane D's 'scenario-outputs/0.1-proposed' stand-in.",
  "type": "object",
  "required": [
    "schema_version",
    "target_role_family",
    "target_skills",
    "coverage_before",
    "coverage_after",
    "leadership_exposure",
    "uncertainty",
    "uncertainty_note",
    "atlas_entity_id",
    "not_a_hiring_probability",
    "metric_semantics",
    "baseline",
    "hypothetical",
    "delta",
    "applied_actions",
    "unmapped_actions",
    "remaining_missing_evidence",
    "effort",
    "movement",
    "map_points",
    "alternatives",
    "confidence_in_role_description",
    "model_ref"
  ],
  "properties": {
    "not_a_hiring_probability": {
      "const": true
    },
    "metric_semantics": {
      "type": "string"
    },
    "baseline": {
      "$ref": "#/$defs/snapshot"
    },
    "hypothetical": {
      "$ref": "#/$defs/snapshot"
    },
    "delta": {
      "type": "object",
      "required": [
        "requirement_shortfall",
        "full_space_distance"
      ]
    },
    "applied_actions": {
      "type": "array"
    },
    "unmapped_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "remaining_missing_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "feature",
          "tier",
          "state",
          "acquisition"
        ]
      }
    },
    "effort": {
      "type": "object",
      "required": [
        "planned_hours",
        "capacity_hours_within_horizon",
        "fits_time_budget",
        "hours_per_week"
      ]
    },
    "movement": {
      "type": "object"
    },
    "map_points": {
      "type": "array",
      "minItems": 2
    },
    "alternatives": {
      "type": "object",
      "required": [
        "same_budget",
        "paths"
      ],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "confidence_in_role_description": {
      "type": "object",
      "required": [
        "level",
        "reasons"
      ]
    },
    "model_ref": {
      "type": "object",
      "required": [
        "model_id",
        "vocab_digest",
        "projection_id"
      ]
    },
    "schema_version": {
      "const": "scenario-outputs/0.1"
    },
    "target_role_family": {
      "type": "string"
    },
    "target_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "coverage_before": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "coverage_after": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "coverage_definition": {
      "type": "string"
    },
    "leadership_exposure": {
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "leadership_exposure_value": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "uncertainty": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "uncertainty_note": {
      "type": "string"
    },
    "atlas_entity_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "required": [
        "requirement_shortfall",
        "full_space_distance",
        "shortfall_rank_among_roles",
        "core_summary"
      ],
      "properties": {
        "requirement_shortfall": {
          "type": "number",
          "minimum": 0
        },
        "full_space_distance": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
